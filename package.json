{
  "name": "cadria-edit",
  "productName": "CADRIA EDIT",
  "version": "1.0.0",
  "description": "CADRIA EDIT - video editor",
  "author": "Nikola",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis zip --publish never"
  },
  "devDependencies": {
    "electron": "43.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "Nikola.CadriaEdit",
    "productName": "CADRIA EDIT",
    "copyright": "Nikola",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "html/**/*",
      "build/icon.png",
      "node_modules/@ffmpeg/ffmpeg/dist/esm/**/*",
      "node_modules/@ffmpeg/util/dist/esm/**/*",
      "node_modules/@ffmpeg/core/dist/esm/**/*",
      "node_modules/@ffmpeg/*/package.json",
      "!node_modules/@ffmpeg/*/dist/umd/**",
      "!node_modules/@ffmpeg/*/dist/cjs/**",
      "!node_modules/@ffmpeg/types/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "CadriaEdit-prenosna.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CADRIA EDIT",
      "artifactName": "CadriaEdit-Setup.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.1"
  }
}